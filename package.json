  "devDependencies": {
    "@codemirror/autocomplete": "^6.16.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "^6.28.0",
    "@types/node": "^20.11.30",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "^0.20.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
{
  "name": "margin-notes",
  "version": "1.1.5",
  "description": "Add margin notes and sidenotes to any file, with per-file selective activation and an optional AI agent that suggests and places annotations for you.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint ."
  },
